# Uzum Seller OpenAPI tokeni (seller.uzum.uz -> Sozlamalar -> API kalitlar)
UZUM_API_TOKEN=
# Do'kon ID (bo'sh qolsa barcha do'konlar)
UZUM_SHOP_ID=
UZUM_BASE_URL=https://api-seller.uzum.uz/api/seller-openapi
# Necha daqiqada bir API dan yangilash
UZUM_SYNC_MINUTES=60
# API dan necha kun orqaga o'qish
UZUM_SYNC_DAYS=90

WEB_HOST=0.0.0.0
WEB_PORT=8080
DATA_DIR=data
